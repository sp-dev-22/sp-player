<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme colour"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/swatch_pink"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent_pink"
                android:contentDescription="Pink" />

            <Button
                android:id="@+id/swatch_blue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent_blue"
                android:contentDescription="Blue" />

            <Button
                android:id="@+id/swatch_green"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent_green"
                android:contentDescription="Green" />

            <Button
                android:id="@+id/swatch_orange"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/accent_orange"
                android:contentDescription="Orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/selected_color_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Selected colour: Pink"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Day / Night"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/night_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/night_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System default (Auto)" />

            <RadioButton
                android:id="@+id/night_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Light" />

            <RadioButton
                android:id="@+id/night_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Video"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/bg_video_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Background play video" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep playing a video's audio when you leave the app"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="YouTube"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/genyt_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Download YT Video &amp; Audio (Third Party)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opens genyt.net in your browser"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Support"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/support_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Support" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About SP Player, links and help"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="SP Player v1.1.1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fully offline • No ads • No internet permission"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</ScrollView>
