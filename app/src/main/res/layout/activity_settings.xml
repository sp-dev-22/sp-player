<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme रंग"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/swatch_pink"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent_pink"
                android:contentDescription="Pink" />

            <Button
                android:id="@+id/swatch_blue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent_blue"
                android:contentDescription="Blue" />

            <Button
                android:id="@+id/swatch_green"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@color/accent_green"
                android:contentDescription="Green" />

            <Button
                android:id="@+id/swatch_orange"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/accent_orange"
                android:contentDescription="Orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/selected_color_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="चुना हुआ रंग: Pink"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Day / Night"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/night_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/night_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="System जैसा (Auto)" />

            <RadioButton
                android:id="@+id/night_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Light" />

            <RadioButton
                android:id="@+id/night_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dark" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="SP Player v1.0.0"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fully offline • No ads • No internet permission"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</ScrollView>
