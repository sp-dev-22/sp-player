<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SPPlayer" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorPrimaryDark">@color/accent_pink_dark</item>
        <item name="colorAccent">@color/accent_pink</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- One variant per theme (v1.2.0): activities pick their style with
         ThemeTint.themeFor(Prefs.accent(...)) before setContentView, so
         switches, radio buttons, dialogs and buttons follow the theme
         instead of staying Pink. -->
    <style name="Theme.SPPlayer.Blue" parent="Theme.SPPlayer">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/accent_blue_dark</item>
        <item name="colorAccent">@color/accent_blue</item>
    </style>

    <style name="Theme.SPPlayer.Green" parent="Theme.SPPlayer">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryDark">@color/accent_green_dark</item>
        <item name="colorAccent">@color/accent_green</item>
    </style>

    <style name="Theme.SPPlayer.Orange" parent="Theme.SPPlayer">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryDark">@color/accent_orange_dark</item>
        <item name="colorAccent">@color/accent_orange</item>
    </style>

    <style name="Theme.SPPlayer.Rainbow" parent="Theme.SPPlayer">
        <item name="colorPrimary">@color/accent_rainbow</item>
        <item name="colorPrimaryDark">@color/accent_rainbow_dark</item>
        <item name="colorAccent">@color/accent_rainbow</item>
    </style>
</resources>
